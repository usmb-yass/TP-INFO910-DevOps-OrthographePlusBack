### BASE DE DONNEES

# URI de connexion à la base de données MongoDB
# exemple : mongodb://127.0.0.1:27017/orthographe_plus
MONGODB_URI=



# --------------- #



### BACK API

# Port sur lequel le serveur Express écoute
# exemple : 3000
PORT=

# Clé secrète pour signer les tokens JWT (min. 32 caractères recommandés)
JWT_SECRET=

# Pour afficher les logs des appels API et des requêtes vers la base de données, attribuer la valeur 'development'
NODE_ENV=

# Origines autorisées pour les requêtes CORS (séparées par des virgules si plusieurs)
# exemple : https://admin.orthographeplus.fr
# En développement local, laisser vide pour autoriser toutes les origines
CORS_ORIGIN=
