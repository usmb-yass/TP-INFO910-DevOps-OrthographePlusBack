### ANCIENNE BASE DE DONNÉES = BASE DE DONNÉES ADULTE

# Le nom d'utilisateur de connexion à l'ancienne base de données
OLD_DB_USER=

# Le mot de passe de l'utilisateur de l'ancienne base de données
OLD_DB_PASSWORD=

# L'hôte (adresse IP ou nom de domaine) où l'ancienne base de données est hébergée
# Exemple : 127.0.0.1
OLD_DB_HOST=

# Le port d'écoute de l'ancienne base de données
# Exemple : 27018
OLD_DB_PORT=

# La base de données d'authentification (généralement il s'agit de 'admin')
# Exemple : admin
OLD_DB_AUTH_SOURCE=
