{
  "name": "orthographeplusback",
  "version": "0.1.0",
  "description": "le backend d'orthographe plus junior",
  "main": "dist/src/serveur.js",
  "imports": {
    "#shared/*": "./dist/shared/*.js"
  },
  "scripts": {
    "start": "node dist/src/serveur.js",
    "build": "tsc",
    "dev": "nodemon",
    "check": "tsc --noEmit && npm run lint",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "db:status": "migrate-mongo status",
    "db:migrate": "migrate-mongo up",
    "db:rollback": "migrate-mongo down",
    "db:create": "migrate-mongo create",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv-safe": "^9.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.7.2",
    "multer": "^2.2.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv-safe": "^9.1.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.0.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
