{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDirs": ["./src", "./shared"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "#shared/*": ["./shared/*"]
    }
  },
  "include": ["src/**/*", "@types/express", "shared"],
  "exclude": ["node_modules", "dist"]
}
